# The root certificates shipped in the library (src/main/resources-raw/zephyr/common/cacert.pem):
# Mozilla's root certificates as curl publishes them (https://curl.se/docs/caextract.html),
# 118 certificates. bin/update_ca_bundle.sh downloads CA_BUNDLE_URL and checks CA_BUNDLE_SHA256;
# bin/check_versions.sh checks the committed file against it. A release moves the three lines to
# the newest dated file (bin/update_ca_bundle.sh --check-latest says whether there is one).
CA_BUNDLE_DATE=2026-11-05
CA_BUNDLE_URL=https://curl.se/ca/cacert-2026-11-05.pem
CA_BUNDLE_SHA256=427c064216761a1e72a8b30f0d954d08cb6e4435a82091fb865afd20c8497285
