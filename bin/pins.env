# Source pins of zephyr-java. Releases are built from the zephyr-backports forks.
# The pins are the zephyr-backports release set of 2026-11-07 (the "Release sets" table in the
# README of the zephyr-backports home repository; POLICY §1: sec.N counts per fork):
#   zephyr            v2.3.0-sec.2  8c6a120256b4bd887d6e7167d929d76e3507e0e5
#   zephyr-cpp        v2.3.0-sec.1  3a2ee602ee28e6b7941b617ad4706349ad992641
# The set also names zephyr-javascript v2.3.0-sec.1 and zephyr-wallet v2.3.0-sec.1, which
# zephyr-java does not build. The release version's sec.N is zephyr's N (the network core).
# The tags are signed with the zephyr-backports release key
#   FB39 94F0 997C A6F0 43D7  2491 9EFF 03F5 27D2 40A1
# and the build scripts run git verify-tag on each tree's own tag when it is present locally
# (advisory when the key is not in the keyring: a build without the key must still work).
# A build against ZephyrProtocol's original of the same release must work too:
#   zephyr    v2.3.0  67c5f53b878fef41fb5e74c4382d5b7a2f37fd8a  https://github.com/ZephyrProtocol/zephyr
#   zephyr-cpp         4a99272f6d7a171cf6625016939094637459975a  https://github.com/ZephyrProtocol/zephyr-cpp
# Never a branch name, never master.
# RELEASE_SET names the set; RELEASE_SET_MEMBERS lists all its members as name:tag:sha (for
# bin/make_manifest.sh, which checks that the zephyr and zephyr-cpp members equal the pins).
ZEPHYR_TAG=v2.3.0-sec.2
ZEPHYR_CPP_TAG=v2.3.0-sec.1
ZEPHYR_CPP_URL=https://github.com/zephyr-backports/zephyr-cpp.git
ZEPHYR_CPP_SHA=3a2ee602ee28e6b7941b617ad4706349ad992641
ZEPHYR_URL=https://github.com/zephyr-backports/zephyr.git
ZEPHYR_SHA=8c6a120256b4bd887d6e7167d929d76e3507e0e5
RELEASE_SET=2026-11-07
RELEASE_SET_MEMBERS="zephyr:v2.3.0-sec.2:8c6a120256b4bd887d6e7167d929d76e3507e0e5 zephyr-cpp:v2.3.0-sec.1:3a2ee602ee28e6b7941b617ad4706349ad992641 zephyr-javascript:v2.3.0-sec.1:7b17a14280bd84ca783287f4640b3c744d25319f zephyr-wallet:v2.3.0-sec.1:edef8c0ee281024de1a718aa6dce39bce75f3687"
