# The previous release whose Maven repository bin/merge_previous_release.sh merges into the site
# of this one, so the Maven repository on Pages keeps every release. PREV_SITE_SHA256 is the
# archive's line in that release's signed SHA256SUMS (gpg --verify SHA256SUMS.asc SHA256SUMS).
# A release moves these three lines to itself when the next one is prepared.
PREV_VERSION=2.3.0-sec.2-java.1
PREV_SITE_URL=https://github.com/loki-notfound/myzephyr-java/releases/download/v2.3.0-sec.2-java.1/site-2.3.0-sec.2-java.1.tar.gz
PREV_SITE_SHA256=9e5561aa78f3bcf0f02d1a7be48bf2a305283bbe22b692f43d3955238d3dfec7
