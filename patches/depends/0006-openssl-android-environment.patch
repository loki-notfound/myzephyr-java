Description: let OpenSSL read the environment in an Android app process
 OpenSSL reads SSL_CERT_FILE, SSL_CERT_DIR and its other environment variables only when
 OPENSSL_issetugid() is false. On Android (__ANDROID_API__ >= 18) crypto/uid.c answers with
 getauxval(AT_SECURE), which is 1 in every app process although an app process is never set-id
 (measured on API 24 and API 35: uid equals euid, AT_SECURE 1), so an app cannot name the CA
 file of the native wallet's TLS connections. This patch adds a patch for OpenSSL's crypto/uid.c
 that removes the Android branch, so that on Android OPENSSL_issetugid() is the file's own last
 branch (getuid() != geteuid() || getgid() != getegid()), as on every platform without
 getauxval. The glibc branch is untouched. Applies to every host; only Android builds change.
Origin: zephyr-java
Forwarded: no
Drop-when: OpenSSL offers another way to name the CA file for a context the caller does not
 own, or the core passes SSL options through

--- a/contrib/depends/packages/openssl.mk
+++ b/contrib/depends/packages/openssl.mk
@@ -3,6 +3,7 @@
 $(package)_download_path=https://github.com/openssl/openssl/releases/download/openssl-$($(package)_version)
 $(package)_file_name=$(package)-$($(package)_version).tar.gz
 $(package)_sha256_hash=67ebca7e50d17383028045486653492195b83db95f8558709701bb47b5c1ef81
+$(package)_patches=android-issetugid-by-uid.patch
 
 define $(package)_set_vars
 $(package)_config_env=AR="$($(package)_ar)" ARFLAGS=$($(package)_arflags) RANLIB="$($(package)_ranlib)" CC="$($(package)_cc)"
@@ -48,6 +49,7 @@
 endef
 
 define $(package)_preprocess_cmds
+  patch -p1 < $($(package)_patch_dir)/android-issetugid-by-uid.patch &&\
   sed -i.old 's|crypto ssl apps util tools fuzz providers doc|crypto ssl util tools providers|' build.info
 endef
 
--- /dev/null
+++ b/contrib/depends/patches/openssl/android-issetugid-by-uid.patch
@@ -0,0 +1,15 @@
+--- a/crypto/uid.c
++++ b/crypto/uid.c
+@@ -36,12 +36,6 @@
+ #include <sys/auxv.h>
+ #define OSSL_IMPLEMENT_GETAUXVAL
+ #endif
+-#elif defined(__ANDROID_API__)
+-/* see https://developer.android.google.cn/ndk/guides/cpu-features */
+-#if __ANDROID_API__ >= 18
+-#include <sys/auxv.h>
+-#define OSSL_IMPLEMENT_GETAUXVAL
+-#endif
+ #endif
+ 
+ int OPENSSL_issetugid(void)
